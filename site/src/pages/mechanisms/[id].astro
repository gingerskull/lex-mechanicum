---
// One page per registered mechanism (SS5, SS8): crumbs, header, stage, side panels, explanation, links. The catalogue
// supplies every word; the drawing comes from the package and the record's kinematics. A fictional seasonal mechanism
// (P14) wears the Seasonal folklore tag, shows its generated images and its related mechanisms in place of
// the links, and out of its listing window a placard with the day it comes back in place of the stage (islands/season.ts);
// a library page links back to the seasonal mechanisms that name it as related while each is listed.
import Sheet from "../../layouts/Sheet.astro";
import "../../../styles/views.css";
import Bar from "../../components/Bar.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import Stage3 from "../../components/Stage3.astro";
import type { ImageMetadata } from "astro";
import { APP, SHEETS, controlsOf, driveOf, imagesShown, neighbours, relatedOf, seasonalFor, sortableOf, viewButtons, type Sheet as SheetInfo } from "../../data";
import { absolute, mechanismLd } from "../../seo";
import { url } from "../../url";

export function getStaticPaths() {
  return SHEETS.map((s) => ({ params: { id: s.id }, props: { sheet: s } }));
}
const { sheet } = Astro.props as { sheet: SheetInfo };
const r = sheet.rec;
const [prev, next] = neighbours(sheet);
const drive = driveOf(sheet.id);
// the construction labels in the record's order: the key a narrow stage shows under its numbered markers (SD22)
function labelsOf(rec: SheetInfo["rec"]): string[] {
  const ovs = ((rec as { teaching?: { overlays?: { label?: unknown }[] } }).teaching?.overlays ?? []) as { label?: unknown }[];
  return ovs.map((o) => o.label).filter((l): l is string => typeof l === "string" && l.length > 0);
}
// a fact's value: plain text, or [text, href] for a value the library filters by
type Part = string | [string, string];
const facetLink = (key: string, v: string) => url(`/?${key}=${encodeURIComponent(v)}`);
const searchLink = (v: string) => url(`/?q=${encodeURIComponent(v.toLowerCase())}`);
// in the Wide facts row (SS9) a fact up to this many characters keeps its width and never wraps; a longer one gets a
// width from its length, so it runs to about two lines
const LONG_FACT = 28;
const textOf = (v: Part[]) => v.map((x) => (typeof x === "string" ? x : x[0])).join("");
const facts: [string, Part[]][] = [
  ["Family", [[r.family, facetLink("family", r.family)]]],
  ["Motion", [[r.motion.input, facetLink("input", r.motion.input)], " → ", [r.motion.output, facetLink("output", r.motion.output)], ` (${r.motion.output_character.join(", ").toLowerCase()})`]],
  ["Ratio", [[r.ratio.kind, r.ratio.class === r.ratio.kind || r.ratio.class === "n/a" ? "" : r.ratio.class].filter(Boolean).join(", ") + (r.ratio.typical ? `: ${r.ratio.typical}` : "")]],
  ["Axes", [r.motion.axes]],
  ["Backdrivable", [r.backdrivable]],
  ["Level", [[r.level, facetLink("level", r.level)]]],
  ["DOF", [String(r.dof)]],
  ["Drive", [drive]],
  ...(r.aka?.length ? ([["Also called", [r.aka.join(", ")]]] as [string, Part[]][]) : []),
];
const explain: [string, string][] = [
  ["How it moves", r.explain.motion],
  ["Forces", r.explain.forces],
  ["Why use it", r.explain.benefits],
  ["Limits", r.explain.limits],
];
// tags link back to the library: a facet value presses its chip there, any other tag searches for it
const tagsets = (
  [
    ["Function", r.tags.function.map((v) => [v, facetLink("function", v)])],
    ["Property", r.tags.property.map((v) => [v, searchLink(v)])],
    ["Application", r.tags.application.map((v) => [v, searchLink(v)])],
    ["Keywords", (r.tags.keywords ?? []).map((v) => [v, searchLink(v)])],
  ] as [string, [string, string][]][]
).filter(([, v]) => v.length > 0);
const added = sortableOf(sheet).added;
// a seasonal mechanism (P14): its images that have a file (site/seasonal, WebP), its related mechanisms; a library page's
// seasonal mechanisms that name it as related
const season = r.season;
const files = import.meta.glob<{ default: ImageMetadata }>("../../../seasonal/*.webp", { eager: true });
const images = imagesShown(r).map((m) => {
  const img = files[`../../../seasonal/${m.file}`]?.default;
  if (!img) throw new Error(`${sheet.id}: image ${m.file} is not in site/seasonal`);
  return { ...m, img };
});
const related = season ? relatedOf(sheet) : [];
const inSeason = seasonalFor(sheet);
const media = r.media.filter((m) => m.kind === "video" || m.kind === "photos");
const demos = r.media.filter((m) => m.kind !== "video" && m.kind !== "photos");
// the page's social card (tools/cards.ts) and its structured data
const card = url(`/cards/${sheet.id}.jpg`);
const cardAlt = `${r.name}: its working drawing on the Blueprint sheet, with its name in the title block`;
const ld = mechanismLd({ name: r.name, description: r.summary, url: absolute(Astro.url.pathname, Astro.site), image: absolute(card, Astro.site), level: r.level, home: absolute(url("/"), Astro.site), keywords: [r.family, ...r.tags.function, ...(r.tags.keywords ?? [])] });
---
<Sheet title={`${r.name} · ${APP}`} description={r.summary} image={card} imageAlt={cardAlt} ld={ld}>
  <Bar title={r.name} />
  <main class="wrap detail">
    <nav class="crumbs" aria-label="Sheets">
      <a class="btn" id="back" href={url("/")}><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>Back to library</a>
      {SHEETS.length > 1 && (
        <div class="nav">
          <a class="btn quiet" id="prev" href={url(`/mechanisms/${prev.id}/`)}>{prev.rec.name}</a>
          <a class="btn quiet" id="next" href={url(`/mechanisms/${next.id}/`)}>{next.rec.name}</a>
        </div>
      )}
    </nav>
    <div class="dhead">
      <div class="meta"><b>{sheet.no}</b>{season ? <span class="folklore">Seasonal folklore</span> : added && <span class="recovered" data-recovered={added} hidden>Recovered</span>} · {r.family} · {r.motion.label}</div>
      <div class="hrow"><h1>{r.name}</h1><ThemeToggle /></div>
      <p>{r.summary}</p>
    </div>
    <script is:inline>
      // the remembered view mode, set before the layout paints (the stage island wires the toggle)
      try {
        if (localStorage.getItem("stage-view") === "wide") document.documentElement.dataset.view = "wide";
      } catch {}
    </script>
    <div class="dlayout">
      {season && (
        <div class="placard" id="placard" hidden>
          <h2>Out of season</h2>
          <p>Packed away with the decorations. It comes back for {season.occasion}<span id="returns"></span>.</p>
        </div>
      )}
      <Stage3 id={sheet.id} no={sheet.no} title={r.name} controls={controlsOf(r)} views={viewButtons(r)} timeMap={Boolean((r as any).teaching?.timeMap)} labels={labelsOf(r)} season={sheet.season} />
      <aside class="side">
        <section class="panel">
          <h2>At a glance</h2>
          <dl class="facts">{facts.map(([k, v]) => (<div class:list={[{ long: textOf(v).length > LONG_FACT }]} style={textOf(v).length > LONG_FACT ? `--n: ${textOf(v).length}` : undefined}><dt>{k}</dt><dd>{v.map((x) => (typeof x === "string" ? x : <a href={x[1]}>{x[0]}</a>))}</dd></div>))}</dl>
        </section>
        {r.build.plot && (
          <section class="panel plot">
            <h2>{r.build.plot}</h2>
            <canvas id="plot" role="img" aria-label={r.build.plot}></canvas>
          </section>
        )}
      </aside>
    </div>
    <section class="tagband" aria-label="Tags">
      {tagsets.map(([k, v]) => (
        <div><span class="lbl">{k}</span>{v.map(([t, href]) => <a class="tag ro" href={href}>{t}</a>)}</div>
      ))}
    </section>
    <div class="explain">
      {explain.map(([h, t], k) => (
        <section><span class="k">{String(k + 1).padStart(2, "0")}</span><h2>{h}</h2><p>{t}</p></section>
      ))}
      {(r.examples?.length ?? 0) > 0 && (
        <section class="wide"><span class="k">05</span><h2>Where you will find it</h2>
          <ul class="uses">{r.examples!.map((x) => <li><b>{x.use}</b><span>{x.detail}</span></li>)}</ul>
        </section>
      )}
      {!season && (r.real_world?.length ?? 0) > 0 && (
        <section class="wide"><span class="k">06</span><h2>In the real world</h2>
          <ul class="uses">{r.real_world!.map((x) => <li><b><a href={x.url} rel="noopener">{x.product}</a></b><span>{x.use}</span></li>)}</ul>
        </section>
      )}
      {season && images.length > 0 && (
        <section class="wide"><span class="k">06</span><h2>In the wild</h2>
          <div class="shots">{images.map((m) => <img src={m.img.src} width={m.img.width} height={m.img.height} alt={m.alt} loading="lazy" decoding="async" />)}</div>
        </section>
      )}
    </div>
    {season ? (
      related.length > 0 && (
        <div class="reflist">
          <section data-seasonlinks><h2>Related</h2><ul class="refs">{related.map((t) => <li data-season={t.season} hidden={t.season !== undefined}><span class="lbl">{t.season ? t.rec.season!.occasion : t.rec.family}</span><a href={url(`/mechanisms/${t.id}/`)}>{t.rec.name}</a></li>)}</ul></section>
        </div>
      )
    ) : (
      <div class="reflist">
        <section><h2>References</h2><ul class="refs">{r.references.map((x) => <li><span class="lbl">{x.kind}</span><a href={x.url} rel="noopener">{x.title}</a></li>)}</ul></section>
        {media.length > 0 && <section><h2>Photos and video</h2><ul class="refs">{media.map((x) => <li><span class="lbl">{x.kind}</span><a href={x.url} rel="noopener">{x.title}</a></li>)}</ul></section>}
        {demos.length > 0 && <section><h2>Animations</h2><ul class="refs">{demos.map((x) => <li><span class="lbl">{x.kind}</span><a href={x.url} rel="noopener">{x.title}</a></li>)}</ul></section>}
        {inSeason.length > 0 && <section data-seasonlinks hidden><h2>In season</h2><ul class="refs">{inSeason.map((t) => <li data-season={t.season} hidden><span class="lbl">{t.rec.season!.occasion}</span><a href={url(`/mechanisms/${t.id}/`)}>{t.rec.name}</a></li>)}</ul></section>}
      </div>
    )}
  </main>
  <script>
    import "../../islands/sheetnav";
    import "../../islands/season";
  </script>
</Sheet>
