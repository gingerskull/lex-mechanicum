---
// The library (SS1 to SS3): every drawn mechanism as a sheet of the set, built in the default order (New); the filters
// island sorts the cards again when the visitor picks another order. The counts are the library's; a seasonal mechanism's
// card (P14) is built hidden, and the filters island shows and counts it in its listing window only (the counts that
// change carry data-sheets, once there is a seasonal mechanism). Above the cards the featured slot (SS16) shows one sheet
// large, picked in the browser for the day.
import Sheet from "../layouts/Sheet.astro";
import Bar from "../components/Bar.astro";
import Facets from "../components/Facets.astro";
import Card from "../components/Card.astro";
import Featured from "../components/Featured.astro";
import { APP, LIBRARY, SHEETS, VERSION, sortableOf } from "../data";
import { DEFAULT_ORDER, sortBy } from "../sort";
import { HINTS } from "../lore";
import { absolute, siteLd } from "../seo";
import { url } from "../url";
// at most about 155 characters, where search results cut it
const description = "Linkages, gears, cams and indexing drives, drawn live as working drawings of real hardware. Turn them, tilt them and take them apart.";
const count = LIBRARY.length;
const live = SHEETS.length > count ? "" : undefined;
---
<Sheet title={`${APP} · Mechanism Library`} description={description} ld={siteLd(absolute(url("/"), Astro.site), description)}>
  <header class="wrap top">
    <div class="brand">
      <p class="kicker">Mechanism Library</p>
      <h1>{APP} <span data-sheets={live}>{count}</span></h1>
      <p>Linkages, gears, cams and indexing drives, built from real hardware and drawn live as working drawings. Open a sheet to turn it, tilt it, pull it apart and see the forces. Handy in class, or just to see how things move.</p>
    </div>
    <div class="tblock" aria-hidden="true">
      <div><i>Set</i><b>ST</b></div>
      <div><i>Sheets</i><b data-sheets={live}>{count}</b></div>
      <div><i>Drawn</i><b>As built</b></div>
      <div data-forge-key><i>Rev</i><b>{VERSION}</b></div>
    </div>
  </header>
  <Bar library set={{ name: "Mechanism Library", count, live: live !== undefined }}><Facets /></Bar>
  <main class="wrap" id="library">
    <Featured />
    <div class="status"><span id="shown">{count} sheets</span><button id="clear" type="button" hidden>Clear filters</button></div>
    <div class="grid" id="grid">
      {sortBy(SHEETS, DEFAULT_ORDER, sortableOf).map((s) => <Card sheet={s} />)}
      <div class="empty" id="empty" hidden>
        <h2>No pattern found</h2>
        <p>No pattern in the archive matches. Clear a filter or the search.</p>
      </div>
      <div class="empty sealed" id="sealed" hidden>
        <h2 id="sealed-title">Pattern sealed</h2>
        <p id="sealed-text">This pattern rests behind a sealed sheet of the archive.</p>
        <p class="lore-hint" data-lore-hint>{HINTS[0]}</p>
      </div>
    </div>
  </main>
  <script>
    import "../islands/filters";
    import "../islands/featured";
    import "../islands/card";
  </script>
</Sheet>
