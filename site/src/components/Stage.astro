---
// The stage and its controls (SS5): play, scrubber, speed, the view modes (Wide, full screen), tilt, explode, the detail
// dial (auto or by hand) and the overlay chips. In full screen on a short landscape screen the same controls reflow into
// a rail beside the drawing (site/styles/views.css).
interface Props {
  id: string;
  no: string;
  title: string;
}
const { id, no, title } = Astro.props;
const overlays = [
  ["paths", "Paths", true],
  ["velocity", "Velocity", false],
  ["forces", "Forces", false],
  ["angles", "Angles", false],
] as const;
---
<div class="stagebox" data-id={id} data-no={no} data-title={title}>
  <div class="stage"><canvas id="stage" role="img" aria-label={`${title}, live drawing`}></canvas></div>
  <div class="controls">
    <button class="play" id="play" type="button" aria-pressed="true" aria-label="Pause">
      <svg viewBox="0 0 12 12" aria-hidden="true"><path id="playicon" d="M3 2h2v8H3zM7 2h2v8H7z" fill="currentColor"></path></svg>
    </button>
    <label class="scrub"><span class="lbl">Cycle</span><input id="scrub" type="range" min="0" max="360" step="1" value="63" /><output id="scrubv">63°</output></label>
    <div class="seg" role="group" aria-label="Speed" id="speed">
      <button type="button" data-v="0.5" aria-pressed="false">½×</button><button type="button" data-v="1" aria-pressed="true">1×</button><button type="button" data-v="2" aria-pressed="false">2×</button>
    </div>
    <div class="views" role="group" aria-label="View">
      <button class="btn" id="wide" type="button" aria-pressed="false" title="Wide: the drawing across the page, the panels below it">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="4" width="13" height="8"></rect></svg>Wide
      </button>
      <button class="btn sq" id="full" type="button" aria-pressed="false" aria-label="Full screen" title="Full screen">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path id="fullicon" d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"></path></svg>
      </button>
    </div>
  </div>
  <div class="controls">
    <label class="sl tilt"><span class="lbl">View</span><input id="tilt" type="range" min="0" max="88" step="1" value="28" /><output id="tiltv">28°</output></label>
    <label class="sl explode"><span class="lbl">Explode</span><input id="explode" type="range" min="0" max="100" step="1" value="0" /><output id="explodev">0%</output></label>
    <div class="dial">
      <button class="btn" id="auto" type="button" aria-pressed="true" title="Drop detail on its own when the drawing is slow">Auto</button>
      <label class="sl"><span class="lbl">Detail</span><input id="detail" type="range" min="0" max="7" step="1" value="7" /><output id="detailv">Full</output></label>
    </div>
  </div>
  <div class="ovl" role="group" aria-label="Overlays">
    {overlays.map(([k, label, on]) => (
      <button class="chip" type="button" data-o={k} aria-pressed={on ? "true" : "false"}><i></i>{label}</button>
    ))}
  </div>
</div>
