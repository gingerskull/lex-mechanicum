---
// The sheet switch (SS7) as one button: it shows the sheet it switches to (a sun on Blueprint for Drafting, a moon on
// Drafting for Blueprint). The theme island wires every one on the page.
---
<button class="themebtn" type="button" data-theme-toggle aria-label="Switch sheet" title="Switch sheet">
  <svg class="to-light" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M3.4 12.6l1.3-1.3M11.3 4.7l1.3-1.3" /></svg>
  <svg class="to-dark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1z" /></svg>
</button>
