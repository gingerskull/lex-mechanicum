---
// The sticky bar (SS3): search and filters on the library, the sheet switch everywhere.
interface Props {
  library?: boolean;
}
const { library = false } = Astro.props;
---
<div class="bar">
  <div class="wrap row">
    {library && (
      <>
        <label class="search">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" /></svg>
          <input id="q" type="search" placeholder="Search mechanisms, uses, tags" aria-label="Search mechanisms" />
        </label>
        <button class="fbtn" id="ftoggle" aria-expanded="false" aria-controls="facets" type="button">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 4h12M4.5 8h7M7 12h2" /></svg>Filters<span class="badge" id="fcount" hidden></span>
        </button>
      </>
    )}
    <span class="spacer"></span>
    <span class="lbl hide-s">Sheet</span>
    <div class="seg" role="group" aria-label="Sheet" id="theme">
      <button type="button" data-v="dark" aria-pressed="true">Blueprint</button><button type="button" data-v="light" aria-pressed="false">Drafting</button>
    </div>
  </div>
  <slot />
</div>
