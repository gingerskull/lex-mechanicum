---
// The sticky bar (SS3). On the library: search, Filters, Sort and the sheet switch on one row, the filter panel under it;
// once the bar sticks, the set's name and sheet count join the row at its left (not on a phone). Sort opens a menu of the
// orders, the current one checked (Oldest origin only once records carry origin dates). On a mechanism page: the
// mechanism's name and the sheet switch, shown once the page's own heading has scrolled away.
import ThemeToggle from "./ThemeToggle.astro";
import { SHEETS, sortableOf } from "../data";
import { DEFAULT_ORDER, ORDERS, offeredOrders } from "../sort";
interface Props {
  library?: boolean;
  /** The library's name and sheet count, shown in the library bar once it sticks. */
  set?: { name: string; count: number };
  /** A mechanism page's name: the bar becomes the compact page bar. */
  title?: string;
}
const { library = false, set, title } = Astro.props;
const offered = library ? offeredOrders(SHEETS.map(sortableOf)) : [];
const orders = ORDERS.filter((o) => offered.includes(o.key));
const current = ORDERS.find((o) => o.key === DEFAULT_ORDER)!;
---
<div class:list={["bar", { pagebar: !!title, libbar: library }]} id={title ? "pagebar" : library ? "libbar" : undefined}>
  <div class="wrap row">
    {library && (
      <>
        {set && <span class="settitle" aria-hidden="true">{set.name} <span>{set.count}</span></span>}
        <div class="search">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" /></svg>
          <input id="q" type="search" placeholder="Search" aria-label="Search mechanisms" autocomplete="off" />
          <button class="qclear" id="qclear" type="button" aria-label="Clear search" title="Clear search" hidden>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" /></svg>
          </button>
        </div>
        <button class="fbtn" id="ftoggle" aria-expanded="false" aria-controls="facets" type="button">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 4h12M4.5 8h7M7 12h2" /></svg>Filters<span class="badge" id="fcount" hidden></span>
        </button>
        <div class="sort">
          <button class="fbtn" id="sbtn" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="sortmenu">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5v11M2 11l2.5 2.5L7 11M9 4h5M9 8h3.5M9 12h2" /></svg>Sort<span class="sortv"><span class="visually-hidden">: </span><span id="sortv">{current.label}</span></span>
          </button>
          <div class="sortmenu" id="sortmenu" role="menu" aria-label="Sort by" hidden>
            {orders.map((o) => (
              <button type="button" role="menuitemradio" tabindex="-1" aria-checked={o.key === current.key ? "true" : "false"} data-sort={o.key}><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" /></svg>{o.label}</button>
            ))}
          </div>
        </div>
      </>
    )}
    {title && <span class="bartitle">{title}</span>}
    <span class="spacer"></span>
    <ThemeToggle />
  </div>
  <slot />
</div>
