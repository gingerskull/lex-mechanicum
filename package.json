{
  "name": "lex-mechanicum",
  "version": "0.48.0",
  "private": true,
  "license": "MIT",
  "description": "An online library of mechanical mechanisms, drawn live as bench assemblies in one house style.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog": "tsx tools/catalog.ts",
    "kin-check": "tsx tools/kin-check.ts",
    "tokens": "tsx tools/tokens-css.ts",
    "prebuild": "npm run tokens && tsx tools/site-assets.ts",
    "package": "tsx tools/package.ts",
    "audit": "tsx tools/audit.ts",
    "judge": "tsx tools/judge.ts",
    "conformance": "tsx tools/conformance.ts",
    "release": "tsx tools/release.ts",
    "typecheck": "tsc",
    "lint": "eslint . && tsx tools/lint-style.ts",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "check": "npm run typecheck && npm run lint && npm run test && npm run conformance",
    "prepare": "git config core.hooksPath .githooks || true",
    "docs:tables": "tsx tools/standard-table.ts && tsx tools/style-table.ts",
    "shot": "tsx tools/shot3.ts",
    "thumbs": "tsx tools/thumbs.ts",
    "cards": "tsx tools/cards.ts",
    "bench": "tsx tools/bench.ts",
    "bench:page": "tsx tools/bench.ts --page",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "build": "astro build --root site",
    "dev": "npm run prebuild && astro dev --root site",
    "preview": "astro preview --root site",
    "test:site": "vitest run --config vitest.site.config.ts",
    "test:e2e": "tsx tools/site-e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gingerskull/lex-mechanicum.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "astro": "^7.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "manifold-3d": "^3.5.4",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "earcut": "^3.2.4"
  }
}
